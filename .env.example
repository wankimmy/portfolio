# Ollama Cloud API key for the AI chatbot — get one at https://ollama.com/settings/keys
# Used server-side only (Vite dev proxy / nginx). Never prefixed with VITE_,
# so it is never bundled into client JavaScript.
OLLAMA_API_KEY=

# Optional: which Ollama Cloud model the chatbot uses (this one IS public/client-visible).
# Default: deepseek-v4.1-flash (picked 2026-11-12). Use the ollama.com API name, no ":cloud" suffix.
VITE_OLLAMA_MODEL=deepseek-v4.1-flash
