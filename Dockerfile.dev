# Development Dockerfile - runs npm run dev (Vite dev server)
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Bake full tree including public/models + public/videos (served from Linux FS).
# docker-compose only bind-mounts src/ + config for HMR — not public/.
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run dev server; --host 0.0.0.0 so it's reachable from host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
